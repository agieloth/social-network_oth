PORT=8080
DB_PATH=./data/social.db
MIGRATIONS_DIR=pkg/db/migrations/sqlite
# Public URL of this API, used to build image URLs
API_BASE_URL=http://localhost:8080
# Comma-separated list of frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
WS_ALLOWED_ORIGINS=http://localhost:3000
# Set to false only for plain-HTTP development on browsers that refuse Secure cookies on localhost
COOKIE_SECURE=true
# Set to true only behind a reverse proxy that sets X-Forwarded-For / Fly-Client-IP
TRUST_PROXY_HEADERS=false
